
{
  "name": "socio-do-tabuleiro",
  "version": "1.0.0",
  "private": true,
  "description": "Marketplace para Mestres, Lojistas e Jogadores de RPG.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:generate": "pnpm --filter @socio/db db:generate",
    "db:migrate": "pnpm --filter @socio/db db:migrate:dev",
    "db:seed": "pnpm --filter @socio/db db:seed",
    "seed:firestore": "tsx scripts/seed-firestore.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "keywords": [
    "rpg",
    "boardgames",
    "marketplace",
    "prisma",
    "supabase",
    "firebase"
  ],
  "author": "Sócio do Tabuleiro Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@supabase/supabase-js": "^2.39.7",
    "dotenv": "^16.4.5",
    "firebase": "^10.8.1",
    "firebase-admin": "^11.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "prisma": "^5.10.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  }
}
