{
  "name": "socio-do-tabuleiro",
  "version": "1.0.0",
  "private": true,
  "description": "Marketplace para Mestres, Lojistas e Jogadores de RPG",
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @socio-do-tabuleiro/api dev",
    "dev:web": "pnpm --filter @socio-do-tabuleiro/web dev",
    "dev:mobile": "pnpm --filter @socio-do-tabuleiro/mobile start",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "build:api": "pnpm --filter @socio-do-tabuleiro/api build",
    "build:web": "pnpm --filter @socio-do-tabuleiro/web build",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm --recursive typecheck",
    "typecheck:api": "pnpm --filter @socio-do-tabuleiro/api typecheck",
    "typecheck:web": "pnpm --filter @socio-do-tabuleiro/web typecheck",
    "typecheck:mobile": "pnpm --filter @socio-do-tabuleiro/mobile typecheck",
    "db:generate": "pnpm --filter @socio-do-tabuleiro/database db:generate",
    "db:migrate": "pnpm --filter @socio-do-tabuleiro/database db:migrate",
    "db:seed": "pnpm --filter @socio-do-tabuleiro/database db:seed",
    "db:studio": "pnpm --filter @socio-do-tabuleiro/database db:studio",
    "db:reset": "pnpm --filter @socio-do-tabuleiro/database db:reset",
    "db:push": "pnpm --filter @socio-do-tabuleiro/database db:push",
    "db:setup": "./scripts/db-setup.sh",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build --no-cache",
    "docker:logs": "docker compose logs -f",
    "docker:logs:api": "docker compose logs -f api",
    "docker:logs:web": "docker compose logs -f web",
    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart",
    "docker:clean": "docker compose down -v --rmi local",
    "clean": "pnpm --recursive exec rm -rf dist node_modules/.cache"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  }
}
